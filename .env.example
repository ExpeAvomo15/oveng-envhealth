# Plantilla de variables de entorno de OVENG EnvHealth.
# Copia este archivo a .env y rellena los valores reales.
# NUNCA commitear .env — solo esta plantilla.
#
# Dónde están: Supabase → Project Settings → API.
#
# El prefijo EXPO_PUBLIC_ hace que Expo incruste el valor en el bundle: son
# públicas por diseño y cualquiera puede leerlas en la app publicada. Lo que
# protege los datos es RLS en Postgres, no el secreto de la clave.
#
# La clave `service_role` NO va aquí ni en ningún archivo del repositorio:
# salta RLS y daría acceso total a la base de datos.

# URL del proyecto: https://<PROJECT_REF>.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Clave pública del proyecto. En el dashboard aparece como "anon public"
# (proyectos nuevos la llaman "publishable key"; ambas valen aquí).
EXPO_PUBLIC_SUPABASE_ANON_KEY=
